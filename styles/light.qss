/* ===== Global ===== */
QWidget {
    background-color: #ffffff;
    color: #1a1a1a;
    font-family: "Segoe UI", "Inter", "Roboto", Arial, sans-serif;
    font-size: 13px;
    outline: none;
}
* { outline: none; }

QLineEdit { color: #111111; }
#totpcopy { color: #111111; }

#TopBar {
    background-color: #ededed;
}

#topelements{
    background-color: #f5f5f7;
    border-radius: 0px;
}

QPushButton#topelements{
    color: #1a1a1a;
    background: #f5f5f7;
    min-height: 15px;
    max-height: 15px;
}

QPushButton#topelements:hover {
    background: #eaf3ff;
    color: #0a0a0a;
    border-color: #075CB2;
}

QPushButton#topelements:pressed {
    background: #075cb2;
    color: #cccccc;
    border-color: #075cb2;
}

QPushButton#topelements:disabled {
    background: #f2f2f2;
    color: #9a9a9a;
    border-color: #e6e6e6;
}

QToolTip {
    background-color: #cccccc;
    color: #1a1a1a;
    border: 1px solid #d0d0d0;
    padding: 6px;
    border-radius: 6px;
}

/* ===== Settings Tabs (Light / Neutral Theme) ===== */

/* Main tab widget */
#SettingsTabs {
    background: transparent;
}

/* Frame / page area */
#SettingsTabs::pane {
    border: 1px solid #d0d0d0;
    background: #f5f5f7;
    border-radius: 0px;
    padding: 4px;
}

/* Tab bar */
#SettingsTabs QTabBar {
    background: transparent;
}

/* Default (unselected) tab */
#SettingsTabs QTabBar::tab {
    background: #f5f5f7;
    color: #333333;
    border: 1px solid #d0d0d0;
    padding: 6px 14px;
    margin-right: 2px;
    margin-top: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

/* Selected tab */
#SettingsTabs QTabBar::tab:selected {
    background: #ffffff;
    color: #1a1a1a;
    border-color: #d0d0d0;
    border-bottom-color: #ffffff;
}

/* Hover (unselected) */
#SettingsTabs QTabBar::tab:hover:!selected {
    background-color: #eaf3ff;
    color: #0a0a0a;
}

/* Disabled tab */
#SettingsTabs QTabBar::tab:disabled {
    background-color: #f2f2f2;
    color: #9a9a9a;
    border-color: #e6e6e6;
}

/* Optional: page content background inside settings tabs */
#SettingsTabs QWidget {
    background-color: #ffffff;
}

/* The container for all hotkey controls */
QWidget#HotkeysPanel {
    background: transparent;
    border: none;
}

/* Labels inside the hotkey panel */
QWidget#HotkeysPanel QLabel {
    color: #1a1a1a;
    padding-right: 6px;
}

/* QKeySequenceEdit fields inside the hotkey panel */
QWidget#HotkeysPanel QKeySequenceEdit {
    min-width: 130px;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid #d0d0d0;
    background-color: #ffffff;
    color: #1a1a1a;
}

/* Focus / hover states to make them feel like inputs, not buttons */
QWidget#HotkeysPanel QKeySequenceEdit:focus {
    border: 1px solid #075cb2;
}

/* Optional: when disabled (if you ever disable them via the checkbox) */
QWidget#HotkeysPanel QKeySequenceEdit:disabled {
    background-color: #f2f2f2;
    border-color: #e6e6e6;
    color: #9a9a9a;
}

/* ===== ModernTable (Light Theme Integration) ===== */
#ModernTable {
    background-color: #ffffff;
    alternate-background-color: #f7f7f7;
    color: #1a1a1a;
    border: 1px solid #d0d0d0;
    border-radius: 0px;
    gridline-color: #e3e3e3;
    selection-background-color: #075cb2;    
    selection-color: #cccccc;
    font-family: "Segoe UI", "Inter", "Roboto", Arial, sans-serif;
    font-size: 13px;
}

/* Headers */
#ModernTable QHeaderView::section {
    background-color: #f5f5f7;
    color: #333333;
    border: none;
    border-bottom: 1px solid #e0e0e0;
    padding: 6px 8px;
    font-weight: 600;
    font-size: 13px;
}
#ModernTable QHeaderView {
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}
#ModernTable QHeaderView::section:hover {
    background-color: #eaf3ff;
}
/* Hover and selected states */
#ModernTable QTableView::item:hover,
#ModernTable::item:hover {
    background-color: transparent;                /* matches global hover blue */
    color: #0a0a0a;                           /* readable dark hover text */
}
#ModernTable QTableView::item:selected,
#ModernTable::item:selected {
    background-color: #075cb2;                /* global blue active */
    color: #cccccc;                           /* global light text on selection */
}

/* Scrollbars (consistent with global design) */
#ModernTable QScrollBar:vertical {
    background: #f2f2f2;
    width: 12px;
}
#ModernTable QScrollBar::handle:vertical {
    background: #cfcfcf;
    min-height: 20px;
    border-radius: 6px;
}
#ModernTable QScrollBar::handle:vertical:hover {
    background: #b6b6b6;
}

#ModernTable QScrollBar:horizontal {
    background: #f2f2f2;
    height: 12px;
}
#ModernTable QScrollBar::handle:horizontal {
    background: #cfcfcf;
    min-width: 20px;
    border-radius: 6px;
}
#ModernTable QScrollBar::handle:horizontal:hover {
    background: #b6b6b6;
}

/* Corner area blend */
#ModernTable QTableCornerButton::section {
    background-color: #f5f5f7;
    border: none;
}

/* ===== Inputs ===== */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, PlusMinusSpinBox, PlusMinusTimeEdit, #prefsTabs QPushButton {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #075cb2;
    selection-color: #cccccc;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QComboBox:hover, QSpinBox:hover, PlusMinusSpinBox:hover, PlusMinusTimeEdit:hover, #prefsTabs QPushButton:hover {
    border-color: #b6b6b6;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus, PlusMinusSpinBox:focus, PlusMinusTimeEdit:focus, #prefsTabs QPushButton:focus {
    border-color: #075cb2;
}

/* ===== Collapsable Section (Light / Neutral Theme) ===== */

QToolButton#SectionHeaderButton {
    font-weight: 600;
    padding: 6px 8px;
    text-align: left;

    background-color: #f5f5f7;      /* same family as tabs / panels */
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
}

/* Hover (unselected / collapsed) */
QToolButton#SectionHeaderButton:hover:!checked {
    background-color: #eaf3ff;      /* light blue hover */
    color: #0a0a0a;
    border-color: #c2c2c2;
}

/* Section has focus (any child widget inside) and is unexpanded */
QToolButton#SectionHeaderButton[sectionFocused="true"]:!checked {
    background-color: #075cb2;      /* strong blue focus */
    color: #cccccc;                 /* matches selection text color */
    border-color: #075cb2;
}

/* Expanded / checked state */
QToolButton#SectionHeaderButton:checked {
    background-color: #ffffff;      /* like selected tab/page */
    color: #1a1a1a;
    border-color: #d0d0d0;
}

/* Expanded + hover */
QToolButton#SectionHeaderButton:checked:hover {
    background-color: #eaf3ff;
    color: #0a0a0a;
    border-color: #c2c2c2;
}

/* Expanded + section-focused */
QToolButton#SectionHeaderButton[sectionFocused="true"]:checked {
    background-color: #075cb2;
    color: #cccccc;
    border-color: #075cb2;
}

/* ===== QSpinBox / Auto-lock field ===== */
QAbstractSpinBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding-right: 28px;
    color: #1a1a1a;
}
QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background: #ffffff;
    border: none;
    width: 24px;
    border-radius: 6px;
}
QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: rgba(7, 92, 178, 0.12);
}

/* ===== Buttons ===== */
QPushButton {
    background-color: #f5f5f7;
    border: 1px solid #d0d0d0;
    padding: 8px 14px;
    border-radius: 6px;
    color: #1a1a1a;
}
QPushButton:hover {
    background-color: #eaf3ff;  /* light blue hover */
    color: #0a0a0a;
    border-color: #c2c2c2;
}
QPushButton:pressed {
    background-color: #075cb2;  /* bright blue active */
    color: #cccccc;
    border-color: #075cb2;
}
QPushButton:disabled {
    background-color: #f2f2f2;
    color: #9a9a9a;
    border-color: #e6e6e6;
}

QDialogButtonBox QPushButton {
    padding: 6px 12px;
    min-width: 88px;
}

/* ===== Checkboxes ===== */
QCheckBox {
    spacing: 6px;
    color: #1a1a1a;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #cfcfcf;
    background-color: #cccccc;
}
QCheckBox::indicator:hover {
    border-color: #075cb2;
    background-color: rgba(7, 92, 178, 0.12);
}
QCheckBox::indicator:checked {
    background-color: #075cb2;
    border: 1px solid #075cb2;
    image: url(:/qt-project.org/styles/commonstyle/images/checkboxindicatorcheck.png);
}
QCheckBox::indicator:disabled {
    background-color: #f3f3f3;
    border-color: #e1e1e1;
}

/* ===== Menus ===== */
QMenuBar {
    background-color: #cccccc;
    color: #1a1a1a;
    padding: 4px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background-color: #eaf3ff;
    color: #0a0a0a;
}
QMenu {
    background-color: #cccccc;
    color: #1a1a1a;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: #eaf3ff;
    color: #0a0a0a;
}
QMenu::item:disabled {
    color: #9a9a9a;
}

/* ===== Tables & Trees ===== */
QTreeWidget, QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #fafafa;
    gridline-color: #e3e3e3;
    outline: none;
    border: none;
}

/* === Tree hover & selected === */
QTreeView::item {
    background-color: transparent;
    color: #1a1a1a;
    padding: 4px 6px;
}
QTreeView::item:hover {
    background-color: #eaf3ff;  /* uniform hover color */
    color: #0a0a0a;
}
QTreeView::item:selected {
    background-color: #075cb2;  /* uniform highlight color */
    color: #cccccc;
}

/* === Table hover & selected === */
QTableView::item {
    border-radius: 0px;
    padding: 4px 6px;
}
QTableView::item:hover {
    background-color: #eaf3ff;
    color: #0a0a0a;
}
QTableView::item:selected {
    background-color: #075cb2;
    color: #cccccc;
    border-radius: 0px;
}

/* ===== Headers ===== */
QHeaderView::section {
    background-color: #f5f5f7;
    color: #333333;
    border: 0;
    padding: 6px 8px;
    font-weight: normal;
}
QTableView:focus QHeaderView::section {
    font-weight: normal;
}

/* ===== Status bar ===== */
QStatusBar {
    background: #f7f7f9;
    color: #333333;
}

/* ===== Splitter ===== */
QSplitter::handle {
    background-color: #ededed;
    margin: 0 2px;
}

/* ===== Scrollbars ===== */
QScrollBar:vertical {
    background: #f2f2f2;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #cfcfcf;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar:horizontal {
    background: #f2f2f2;
    height: 12px;
}
QScrollBar::handle:horizontal {
    background: #cfcfcf;
    min-width: 20px;
    border-radius: 6px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0; width: 0;
}

/* ===== Hints ===== */
QLabel#hint {
    color: #666666;
    font-size: 12px;
    margin-top: 6px;
}

/* ===== Global focus removal ===== */
QTreeView, QTableView, QLineEdit, QTextEdit, QPlainTextEdit,
QComboBox, QSpinBox, QAbstractSpinBox, QPushButton, QScrollBar,
QMenu, QMenuBar, QHeaderView, QSplitter {
    outline: none;
}

/* Optional per-widget tweak */
QAbstractSpinBox#autoLockSpin {
    padding-right: 28px;
}
QAbstractSpinBox#autoLockSpin::up-button,
QAbstractSpinBox#autoLockSpin::down-button {
    width: 24px;
}

TotpRingWidget {
    qproperty-ringColor: #075cb2;
    qproperty-trackColor: #cfcfcf;
    qproperty-bgColor: transparent;
    qproperty-thickness: 4;
}