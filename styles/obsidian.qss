/* ===== Global ===== */
QWidget {
    background-color: #0c0f14;  /* deep charcoal */
    color: #e4e9ef;
    font-family: "Segoe UI", "Inter", "Roboto", Arial, sans-serif;
    font-size: 13px;
    outline: none;
}
* { outline: none; }

QLineEdit { color: #ffffff; }
#totpcopy { color: #ffffff; }

#TopBar {
    background-color: #1a2028;
}

#topelements{
    background-color: #0c0f14;
    border-radius: 0px;
}

QPushButton#topelements{
    color: #ffffff;
    background: #171b23;
    min-height: 15px;
    max-height: 15px;
}

QPushButton#topelements:hover   { background: #0b2529; color: #fff; border-color: #00b3c0; }
QPushButton#topelements:focus { border-color: #00b3c0; }
QPushButton#topelements:pressed { background: #00b3c0; color: #fff; border-color:#00b3c0; }
QPushButton#topelements:disabled{ background: #151920; color: #181818; border-color:#262c36; }

QToolTip {
    background-color: #1a2028;
    color: #f4f7fb;
    border: 1px solid #313b47;
    padding: 6px;
    border-radius: 6px;
}

QLabel#DragPreviewChip {
    background: #111827;
    color: #e5e7eb;
    border-radius: 6px;
    padding: 4px 10px;
    border: 1px solid #4b5563;
}

QMenu#RoundedMenu {
    color: #ffffff;
    border: 1px solid #1a2028;
    padding: 4px 4px 8px 4px;
}

QMenu#RoundedMenu::item {
    padding: 8px 22px 8px 12px;
    margin: 2px 4px;
    border-radius: 4px;
}

QMenu#RoundedMenu::item:selected {
    background-color: #d2e2ff;
    color: #11151e;
}

QMenu#RoundedMenu::item:disabled {
    color: #9aa4b6;
}

/* Entry Tabs */
#EntryTabs {
    background: transparent;
}

/* The frame / page area */
#EntryTabs::pane {
    border: 1px solid #313b47;
    background: #141920;
    border-radius: 0px;
    padding: 0px;
}
/* Entry tab */
/* Tab bar */
#EntryTabs QTabBar {
    background: transparent;
}

/* Default tab appearance */
#EntryTabs QTabBar::tab {
    background: #171b23;
    color: #dde3ea;
    border: 1px solid #313b47;
    padding: 6px 14px;
    margin-right: 2px;
    margin-top: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

/* Selected tab */
#EntryTabs QTabBar::tab:selected {
    background: #0c0f14;
    color: #ffffff;
    border-color: #313b47;
    border-bottom-color: #0c0f14;
}

/* Hover (unselected) */
#EntryTabs QTabBar::tab:hover:!selected {
    background: #0b2529;
    color: #ffffff;
}

/* Disabled tab */
#EntryTabs QTabBar::tab:disabled {
    background: #151920;
    color: #7b858f;
    border-color: #262c36;
}

/* Optional: inner pages inside settings tabs */
#EntryTabs QWidget {
    background-color: #0c0f14;
}

#EntryTabs PlusMinusSpinBox, #EntryTabs QPushButton, #EntryTabs QComboBox, #EntryTabs QLineEdit, #EntryTabs QTimeEdit{
    background-color: #141920;
}

/* ===== Settings Tabs (Obsidian Theme) ===== */

/* Main tab widget */
#SettingsTabs {
    background: transparent;
}

/* The frame / page area */
#SettingsTabs::pane {
    border: 1px solid #313b47;
    background: #141920;
    border-radius: 0px;
    padding: 0px;
}
/* Entry tab */
/* Tab bar */
#SettingsTabs QTabBar {
    background: transparent;
}

/* Default tab appearance */
#SettingsTabs QTabBar::tab {
    background: #171b23;
    color: #dde3ea;
    border: 1px solid #313b47;
    padding: 6px 14px;
    margin-right: 2px;
    margin-top: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

/* Selected tab */
#SettingsTabs QTabBar::tab:selected {
    background: #0c0f14;
    color: #ffffff;
    border-color: #313b47;
    border-bottom-color: #0c0f14;
}

/* Hover (unselected) */
#SettingsTabs QTabBar::tab:hover:!selected {
    background: #0b2529;
    color: #ffffff;
}

/* Disabled tab */
#SettingsTabs QTabBar::tab:disabled {
    background: #151920;
    color: #7b858f;
    border-color: #262c36;
}

/* Optional: inner pages inside settings tabs */
#SettingsTabs QWidget {
    background-color: #0c0f14;
}

#SettingsTabs PlusMinusSpinBox, #SettingsTabs QPushButton, #SettingsTabs QComboBox, #SettingsTabs QLineEdit, #SettingsTabs QTimeEdit{
    background-color: #141920;
}

/* The container for all hotkey controls */
QWidget#HotkeysPanel {
    background: transparent;
    border: none;
}

/* Labels inside the hotkey panel */
QWidget#HotkeysPanel QLabel {
    color: #e5e7eb;
    padding-right: 6px;
}

/* QKeySequenceEdit fields inside the hotkey panel */
QWidget#HotkeysPanel QKeySequenceEdit {
    min-width: 130px;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid #4b5563;
    background-color: #111827;
}

/* Focus / hover states to make them feel like inputs, not buttons */
QWidget#HotkeysPanel QKeySequenceEdit:focus {
    border: 1px solid #10b981;   /* accent color */
}

/* Optional: when disabled (if you ever disable them via the checkbox) */
QWidget#HotkeysPanel QKeySequenceEdit:disabled {
    background-color: #1f2933;
    border-color: #374151;
    color: #6b7280;
}

/* ===== ModernTable (Obsidian Theme Integration) ===== */
#ModernTable {
    background-color: #0c0f14;
    alternate-background-color: #141920;
    color: #e4e9ef;
    border: 1px solid #313b47;
    border-radius: 0px;
    gridline-color: #28323e;
    selection-background-color: #00b3c0;
    selection-color: #ffffff;
    font-family: "Segoe UI", "Inter", "Roboto", Arial, sans-serif;
    font-size: 13px;
}

/* Header styling */
#ModernTable QHeaderView::section {
    background-color: #171b23;
    color: #dde3ea;
    border: none;
    border-bottom: 1px solid #28323e;
    padding: 6px 8px;
    font-weight: 600;
    font-size: 13px;
}
#ModernTable QHeaderView {
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}
#ModernTable QHeaderView::section:hover {
    background-color: #202733;
}

/* Hover and selected rows */
#ModernTable QTableView::item:selected,
#ModernTable::item:selected {
    background-color: #00b3c0;
    color: #ffffff;
}

/* Scrollbars */
#ModernTable QScrollBar:vertical {
    background: #121720;
    width: 12px;
}
#ModernTable QScrollBar::handle:vertical {
    background: #28323e;
    min-height: 20px;
    border-radius: 6px;
}
#ModernTable QScrollBar::handle:vertical:hover {
    background: #324052;
}
#ModernTable QScrollBar:horizontal {
    background: #121720;
    height: 12px;
}
#ModernTable QScrollBar::handle:horizontal {
    background: #28323e;
    min-width: 20px;
    border-radius: 6px;
}
#ModernTable QScrollBar::handle:horizontal:hover {
    background: #324052;
}

/* Corner section */
#ModernTable QTableCornerButton::section {
    background-color: #171b23;
    border: none;
}

/* ===== Inputs (Obsidian-style) ===== */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
PlusMinusSpinBox,
QTimeEdit,
PlusMinusTimeEdit,
#prefsTabs QPushButton {
    background-color: #151920;          /* field bg */
    border: 1px solid #313b47;          /* normal border */
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #00b3c0; /* teal selection */
    selection-color: #ffffff;
    color: #e4e9ef;
}

/* Hover: slightly brighter bg + accent border */
QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QComboBox:hover,
QSpinBox:hover,
PlusMinusSpinBox:hover,
QTimeEdit:hover,
PlusMinusTimeEdit:hover,
#prefsTabs QPushButton:hover {
    border-color: #00b3c0;
}

/* Focus: keep accent border (can be same as hover for consistency) */
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
PlusMinusSpinBox:focus,
QTimeEdit:focus,
PlusMinusTimeEdit:focus,
#prefsTabs QPushButton:focus {
    border-color: #00b3c0;
}

/* ===== Collapsable Section (Obsidian Theme) ===== */

QToolButton#SectionHeaderButton {
    font-weight: 600;
    padding: 6px 8px;
    text-align: left;

    background-color: #171b23;      /* matches tabs/buttons */
    color: #dde3ea;
    border: 1px solid #313b47;
    border-radius: 6px;
}

/* Hover (unselected / collapsed) */
QToolButton#SectionHeaderButton:hover:!checked {
    background-color: #0b2529;      /* same hover tone as buttons */
    color: #ffffff;
    border-color: #313b47;
}

/* Section has focus (any child widget inside) and is unexpanded */
QToolButton#SectionHeaderButton[sectionFocused="true"]:!checked {
    background-color: #00b3c0;      /* teal accent */
    color: #ffffff;
    border-color: #00b3c0;
}

/* Expanded / checked state */
QToolButton#SectionHeaderButton:checked {
    background-color: #0c0f14;      /* main window bg */
    color: #e4e9ef;
    border-color: #313b47;
}

/* Expanded + hover */
QToolButton#SectionHeaderButton:checked:hover {
    background-color: #0b2529;
    color: #ffffff;
    border-color: #324052;
}

/* Expanded + section-focused */
QToolButton#SectionHeaderButton[sectionFocused="true"]:checked {
    background-color: #00b3c0;
    color: #ffffff;
    border-color: #00b3c0;
}

/* ===== QSpinBox / Auto-lock field ===== */
QAbstractSpinBox {
    background-color: #151920;
    border: 1px solid #313b47;
    border-radius: 6px;
    padding-right: 28px;
    color: #e4e9ef;
}
QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background: transparent;
    border: none;
    width: 24px;
    border-radius: 6px;
}
QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: rgba(0, 179, 192, 0.18);
}

/* ===== Buttons ===== */
QPushButton {
    background-color: #171b23;
    border: 1px solid #313b47;
    padding: 8px 14px;
    border-radius: 6px;
    color: #e4e9ef;
}
QPushButton:hover {
    background-color: #0b2529;
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #00b3c0;
    color: #ffffff;
}
QPushButton:disabled {
    background-color: #151920;
    color: #7b858f;
    border-color: #262c36;
}

QDialogButtonBox QPushButton {
    padding: 6px 12px;
    min-width: 88px;
}

/* ===== Checkboxes ===== */
QCheckBox {
    spacing: 6px;
    color: #e4e9ef;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #313b47;
    background-color: #151920;
}
QCheckBox::indicator:hover {
    border-color: #00b3c0;
    background-color: rgba(0, 179, 192, 0.18);
}
QCheckBox::indicator:checked {
    background-color: #00b3c0;
    border: 1px solid #00b3c0;
}
QCheckBox::indicator:disabled {
    background-color: #181d26;
    border-color: #28323e;
}

/* ===== Menus ===== */
QMenuBar {
    background-color: #10151d;
    color: #ffffff;
    padding: 4px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background-color: #0b2529;
    color: #ffffff;
}
QMenu {
    background-color: #1a2028;
    color: #ffffff;
    border: 1px solid #313b47;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: #0b2529;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #8b96a3;
}

/* ===== Tables & Trees ===== */
QTreeWidget, QTableWidget, QTableView {
    background-color: #0c0f14;
    alternate-background-color: #141920;
    gridline-color: #28323e;
    outline: none;
    border: none;
}

QWidget#prefsTabs{
    background: #141920;
}

/* Make all text-ish widgets inside the prefs card inherit the card bg */
#prefsTabs QLabel,
#prefsTabs QCheckBox,
#prefsTabs QRadioButton,
#prefsTabs QGroupBox {
    background-color: #141920;
}

/* ===== Tabs ===== */
QTabWidget::pane {
    border: 1px solid #313b47;
    border-top-color: #141920;
    border-right-color: #313b47;
    border-bottom-color: #313b47;
    border-left-color: #313b47;
    outline: none;
    border-image: none;
}

/* === Tree hover & selected === */
QTreeView::item {
    background-color: transparent;
    color: #e4e9ef;
    padding: 4px 6px;
}
QTreeView::item:hover {
    background-color: #0b2529;
    color: #ffffff;
}
QTreeView::item:selected {
    background-color: #00b3c0;
    color: #ffffff;
}

/* ===== Status bar ===== */
QStatusBar {
    background: #10151d;
    color: #d4dde6;
}

/* ===== Splitter ===== */
QSplitter::handle {
    background-color: #1a2028;
    margin: 0 2px;
}

/* ===== Scrollbars ===== */
QScrollBar:vertical {
    background: #121720;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #28323e;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #324052;
}
QScrollBar:horizontal {
    background: #121720;
    height: 12px;
}
QScrollBar::handle:horizontal {
    background: #28323e;
    min-width: 20px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover {
    background: #324052;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0; width: 0;
}

/* ===== Hints ===== */
QLabel#hint {
    color: #9ba8b7;
    font-size: 12px;
    margin-top: 6px;
}

/* ===== Global focus removal ===== */
QTreeView, QTableView, QLineEdit, QTextEdit, QPlainTextEdit,
QComboBox, QSpinBox, QAbstractSpinBox, QPushButton, QScrollBar,
QMenu, QMenuBar, QHeaderView, QSplitter {
    outline: none;
}

/* ===== TOTP Ring Widget ===== */
TotpRingWidget {
    qproperty-ringColor: #00b3c0;   /* teal ring */
    qproperty-trackColor: #28323e;  /* track */
    qproperty-bgColor: transparent;
    qproperty-thickness: 4;
}
