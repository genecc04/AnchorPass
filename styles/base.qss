/* Keep only non-theme, structural defaults here. Colors live in dark.qss. */

QWidget {
    font-family: "Segoe UI", "Inter", "Roboto", Arial, sans-serif;
    font-size: 13px;
    outline: none;
}
* { outline: none; }

/* ===== LockOverlay ===== */
#LockOverlay {
                background: rgba(0, 0, 0, 0.45);
            }


#LockOverlay QPushButton {
    font-size: 40px;
    padding: 8px 32px;
    font-weight: 600;
}

/* QMenuBar base look */
QMenuBar#AppMenuBar {
    background: #0f172a;    /* slate-900-ish */
    color: #e5e7eb;         /* slate-200 */
}

QMenuBar#AppMenuBar::item {
    padding: 6px 10px;
    background: transparent;
}

/* normal hover/active */
QMenuBar#AppMenuBar::item:selected {
    background: rgba(255,255,255,0.06);
    border-radius: 6px;
}

/* pure disabled (when you call setEnabled(false)) */
QMenuBar#AppMenuBar:disabled {
    background: #0b1220;
    color: #8a8f98;
}
QMenuBar#AppMenuBar:disabled::item {
    color: #8a8f98;
}
QMenuBar#AppMenuBar:disabled::item:selected,
QMenuBar#AppMenuBar:disabled::item:pressed {
    background: transparent; /* no hover highlight when disabled */
}

/* OPTIONAL: locked property – lets you style even if you keep some actions enabled */
QMenuBar#AppMenuBar[locked="true"] {
    background: #0b1220;
    color: #8a8f98;
    /* subtle top border to signal state */
    border-bottom: 1px solid rgba(255,255,255,0.08);
}
QMenuBar#AppMenuBar[locked="true"]::item {
    color: #8a8f98;
}
QMenuBar#AppMenuBar[locked="true"]::item:selected,
QMenuBar#AppMenuBar[locked="true"]::item:pressed {
    background: transparent;
}

/* QComboBox */
QComboBox::drop-down {
    width: 0;
    border: none;
    padding: 0;
}
QComboBox::down-arrow {
    width: 0;
    height: 0;
    image: none;
}
/* remove the space usually reserved for the arrow */
QComboBox {
    padding-right: 8px;  /* keep your existing padding; just ensure it's not huge */
}

/* Date/Time edits that show a drop-down (e.g., calendar) */
QDateEdit::drop-down,
QTimeEdit::drop-down,
QDateTimeEdit::drop-down {
    width: 0;
    border: none;
    padding: 0;
}
QDateEdit::down-arrow,
QTimeEdit::down-arrow,
QDateTimeEdit::down-arrow {
    width: 0;
    height: 0;
    image: none;
}

QFrame {
    border: none;
}