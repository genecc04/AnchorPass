/* ===== Global ===== */
QWidget {
    background-color: #121212;
    color: #e6e6e6;
    font-family: "Segoe UI", "Inter", "Roboto", Arial, sans-serif;
    font-size: 13px;
    outline: none;
}
* { outline: none; }

QLineEdit { color: #ffffff; }
#totpcopy { color: #ffffff; }

#TopBar {
    background-color: #232323;
}

#topelements{
    background-color: #121212;
    border-radius: 0px;
}

QPushButton#topelements{
    color: #ffffff;
    background: #1f1f1f;
    min-height: 15px;
    max-height: 15px;
}

QPushButton#topelements:hover   { background: #061019; color: #fff; border-color: #075cb2; }
QPushButton#topelements:focus { border-color: #075cb2; }
QPushButton#topelements:pressed { background: #075cb2; color: #fff; border-color:#075cb2; }
QPushButton#topelements:disabled{ background: #1a1a1a; color: #181818; border-color:#2a2a2a; }

QToolTip {
    background-color: #262626;
    color: #fafafa;
    border: 1px solid #3a3a3a;
    padding: 6px;
    border-radius: 6px;
}

QLabel#DragPreviewChip {
    background-color: #1f1f1f;
    color: #e6e6e6;
    border-radius: 6px;
    padding: 4px 10px;
    border: 1px solid #333333;
}

QMenu#RoundedMenu {
    color: #ffffff;
    border: 1px solid #232323;
    padding: 4px 4px 8px 4px;
}

QMenu#RoundedMenu::item {
    padding: 8px 22px 8px 12px;
    margin: 2px 4px;
    border-radius: 4px;
}

QMenu#RoundedMenu::item:selected {
    background-color: #d2e2ff;
    color: #11151e;
}

QMenu#RoundedMenu::item:disabled {
    color: #9aa4b6;
}
/* ===== Settings Tabs (Dark Theme) ===== */

/* Main tab widget */
#EntryTabs {
    background: transparent;
}

/* Frame / page area */
#EntryTabs::pane {
    border: none;
    background: transparent;
    border-radius: 0px;
    padding: 4px;
}

/* Tab bar */
#EntryTabs QTabBar {
    background: transparent;
}

/* Default (unselected) tab */
#EntryTabs QTabBar::tab {
    background: #121212;
    color: #dcdcdc;
    border: 1px solid #333333;
    padding: 6px 14px;
    margin-right: 2px;
    margin-top: 2px;
    border-radius: 6px;
}

/* Selected tab */
#EntryTabs QTabBar::tab:selected {
    background: #1f1f1f;
    color: #ffffff;
    border-color: #333333;
}

/* Hover (unselected) */
#EntryTabs QTabBar::tab:hover:!selected {
    background-color: #061019;
    color: #ffffff;
}

/* Disabled tab */
#EntryTabs QTabBar::tab:disabled {
    background-color: #1a1a1a;
    color: #777777;
    border-color: transparent;
}

/* Optional: inner page content background inside settings tabs */
#EntryTabs QWidget {
    background-color: #121212;
}

#EntryTabs PlusMinusSpinBox, #EntryTabs QComboBox, #EntryTabs QLineEdit, #EntryTabs QTimeEdit, #EntryTabs QPlainTextEdit{
    background-color: #181818;
}

#EntryTabs QPushButton {
    background-color: #1f1f1f;
    border: 1px solid #333333;
    padding: 8px 14px;
    border-radius: 6px;
    color: #e6e6e6;
}
#EntryTabs QPushButton:hover {
    background-color: #061019;  /* subtle dark hover */
    color: #ffffff;
}
#EntryTabs QPushButton:pressed {
    background-color: #075cb2;  /* bright blue active */
    color: #ffffff;
}
#EntryTabs QPushButton:disabled {
    background-color: #1a1a1a;
    color: #777777;
    border-color: #2a2a2a;
}

/* Main tab widget */
#SettingsTabs {
    background: transparent;
}

/* Frame / page area */
#SettingsTabs::pane {
    border: 1px solid #333333;
    background: #181818;
    border-radius: 0px;
    padding: 4px;
}

/* Tab bar */
#SettingsTabs QTabBar {
    background: transparent;
}

/* Default (unselected) tab */
#SettingsTabs QTabBar::tab {
    background: #1f1f1f;
    color: #dcdcdc;
    border: 1px solid #333333;
    padding: 6px 14px;
    margin-right: 2px;
    margin-top: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

/* Selected tab */
#SettingsTabs QTabBar::tab:selected {
    background: #121212;
    color: #ffffff;
    border-color: #333333;
    border-bottom-color: #121212;
}

/* Hover (unselected) */
#SettingsTabs QTabBar::tab:hover:!selected {
    background-color: #061019;
    color: #ffffff;
}

/* Disabled tab */
#SettingsTabs QTabBar::tab:disabled {
    background-color: #1a1a1a;
    color: #777777;
    border-color: #2a2a2a;
}

/* Optional: inner page content background inside settings tabs */
#SettingsTabs QWidget {
    background-color: #121212;
}

#SettingsTabs PlusMinusSpinBox, #SettingsTabs QPushButton, #SettingsTabs QComboBox, #SettingsTabs QLineEdit, #SettingsTabs QTimeEdit{
    background-color: #181818;
}

/* The container for all hotkey controls */
QWidget#HotkeysPanel {
    background: transparent;
    border: none;
}

/* Labels inside the hotkey panel */
QWidget#HotkeysPanel QLabel {
    color: #e6e6e6;
    padding-right: 6px;
}

/* QKeySequenceEdit fields inside the hotkey panel */
QWidget#HotkeysPanel QKeySequenceEdit {
    min-width: 130px;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid #333333;
    background-color: #1a1a1a;
}

/* Focus / hover states to make them feel like inputs, not buttons */
QWidget#HotkeysPanel QKeySequenceEdit:focus {
    border: 1px solid #075cb2;
}

/* Optional: when disabled (if you ever disable them via the checkbox) */
QWidget#HotkeysPanel QKeySequenceEdit:disabled {
    background-color: #1a1a1a;
    border-color: #2a2a2a;
    color: #777777;
}


/* ===== ModernTable (Dark Theme Integration) ===== */
#ModernTable {
    background-color: #121212;
    alternate-background-color: #181818;
    color: #e6e6e6;
    border: 1px solid #333333;
    border-radius: 0px;
    gridline-color: #2a2a2a;
    selection-background-color: #075cb2;
    selection-color: #ffffff;
    font-family: "Segoe UI", "Inter", "Roboto", Arial, sans-serif;
    font-size: 13px;
}

/* Header styling to match global QHeaderView colors */
#ModernTable QHeaderView::section {
    background-color: #1f1f1f;
    color: #dcdcdc;
    border: none;
    border-bottom: 1px solid #2a2a2a;
    padding: 6px 8px;
    font-weight: 600;
    font-size: 13px;
}
#ModernTable QHeaderView {
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}
#ModernTable QHeaderView::section:hover {
    background-color: #061019;
}
/* Hover and selected rows — consistent with global table behavior */
#ModernTable QTableView::item:selected,
#ModernTable::item:selected {
    background-color: #075cb2;
    color: #ffffff;
}

/* Scrollbars matching global scrollbar design */
#ModernTable QScrollBar:vertical {
    background: #171717;
    width: 12px;
}
#ModernTable QScrollBar::handle:vertical {
    background: #343434;
    min-height: 20px;
    border-radius: 6px;
}
#ModernTable QScrollBar::handle:vertical:hover {
    background: #4a4a4a;
}
#ModernTable QScrollBar:horizontal {
    background: #171717;
    height: 12px;
}
#ModernTable QScrollBar::handle:horizontal {
    background: #343434;
    min-width: 20px;
    border-radius: 6px;
}
#ModernTable QScrollBar::handle:horizontal:hover {
    background: #4a4a4a;
}

/* Corner section to blend with header */
#ModernTable QTableCornerButton::section {
    background-color: #1f1f1f;
    border: none;
}
/* ===== HistoryTable (Dark Theme Integration) ===== */
#HistoryTable {
    background-color: #121212;
    alternate-background-color: #181818;
    color: #e6e6e6;
    border: 1px solid #333333;
    border-radius: 0px;
    gridline-color: #2a2a2a;
    selection-background-color: #075cb2;
    selection-color: #ffffff;
    font-family: "Segoe UI", "Inter", "Roboto", Arial, sans-serif;
    font-size: 13px;
}

/* Headers */
QHeaderView::section {
    background-color: #1f1f1f;
    color: #dcdcdc;
    border: none;
    border-bottom: 1px solid #2a2a2a;
    padding: 6px 8px;
    font-weight: 600;
    font-size: 13px;
}

QHeaderView::section:hover {
    background-color: #061019;
}

QHeaderView {
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

/* Corner area blend */
#HistoryTable QTableCornerButton::section {
    background-color: #1f1f1f;
    border: none;
}

/* ===== Inputs (Dark theme) ===== */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
PlusMinusSpinBox,
QTimeEdit,
PlusMinusTimeEdit,
#prefsTabs QPushButton {
    background-color: #1a1a1a;          /* field background */
    border: 1px solid #333333;          /* normal border */
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #075cb2; /* blue selection */
    selection-color: #ffffff;
    color: #e6e6e6;
}

/* Hover: subtle highlight */
QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QComboBox:hover,
QSpinBox:hover,
PlusMinusSpinBox:hover,
QTimeEdit:hover,
PlusMinusTimeEdit:hover,
#prefsTabs QPushButton:hover {
    border-color: #075cb2;  /* slightly lighter / bluer tint */
}

/* Focus: strong accent border */
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
PlusMinusSpinBox:focus,
QTimeEdit:focus,
PlusMinusTimeEdit:focus,
#prefsTabs QPushButton:focus {
    border-color: #075cb2;
}

/* ===== Collapsable Section (Dark Theme) ===== */

QToolButton#SectionHeaderButton {
    font-weight: 600;
    padding: 6px 8px;
    text-align: left;

    background-color: #1f1f1f;      /* same as buttons / tabs */
    color: #e6e6e6;
    border: 1px solid #333333;
    border-radius: 6px;
}

/* Hover (unselected / collapsed) */
QToolButton#SectionHeaderButton:hover:!checked {
    background-color: #061019;      /* same hover as buttons / tabs */
    color: #ffffff;
    border-color: #075cb2;          /* subtle blue edge */
}

/* Section has focus (any child widget inside) and is unexpanded */
QToolButton#SectionHeaderButton[sectionFocused="true"]:!checked {
    background-color: #075cb2;      /* strong blue focus */
    color: #ffffff;
    border-color: #075cb2;
}

/* Expanded / checked state */
QToolButton#SectionHeaderButton:checked {
    background-color: #121212;      /* match main bg / selected tab area */
    color: #ffffff;
    border-color: #333333;
}

/* Expanded + hover */
QToolButton#SectionHeaderButton:checked:hover {
    background-color: #181818;      /* slightly lighter for hover */
    color: #ffffff;
    border-color: #4a4a4a;
}

/* Expanded + section-focused */
QToolButton#SectionHeaderButton[sectionFocused="true"]:checked {
    background-color: #075cb2;      /* same strong blue focus */
    color: #ffffff;
    border-color: #075cb2;
}

/* ===== QSpinBox / Auto-lock field ===== */
QAbstractSpinBox {
    background-color: #1a1a1a;
    border: 1px solid #333333;
    border-radius: 6px;
    padding-right: 28px;
    color: #e6e6e6;
}
QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background: transparent;
    border: none;
    width: 24px;
    border-radius: 6px;
}
QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: rgba(7, 92, 178, 0.15);
}

/* ===== Buttons ===== */
QPushButton {
    background-color: #1f1f1f;
    border: 1px solid #333333;
    padding: 8px 14px;
    border-radius: 6px;
    color: #e6e6e6;
}
QPushButton:hover {
    background-color: #061019;  /* subtle dark hover */
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #075cb2;  /* bright blue active */
    color: #ffffff;
}
QPushButton:disabled {
    background-color: #1a1a1a;
    color: #777777;
    border-color: #2a2a2a;
}

QDialogButtonBox QPushButton {
    padding: 6px 12px;
    min-width: 88px;
}

/* ===== Checkboxes ===== */
QCheckBox {
    spacing: 6px;
    color: #e6e6e6;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #333333;
    background-color: #1a1a1a;
}
QCheckBox::indicator:hover {
    border-color: #075cb2;
    background-color: rgba(7, 92, 178, 0.15);
}
QCheckBox::indicator:checked {
    background-color: #075cb2;
    border: 1px solid #075cb2;
}
QCheckBox::indicator:disabled {
    background-color: #222222;
    border-color: #2a2a2a;
}

/* ===== Menus ===== */
QMenuBar {
    background-color: #1b1b1b;
    color: #ffffff;
    padding: 4px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background-color: #061019;
    color: #ffffff;
}
QMenu {
    background-color: #232323;
    color: #ffffff;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: #061019;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #7a7a7a;
}

/* ===== Tables & Trees ===== */
QTreeWidget, QTableWidget, QTableView {
    background-color: #121212;
    alternate-background-color: #181818;
    gridline-color: #2a2a2a;
    outline: none;
    border: none;
}
QWidget#prefsTabs{
    background: #181818;
}

/* Make all text-ish widgets inside the prefs card inherit the card bg */
#prefsTabs QLabel,
#prefsTabs QCheckBox,
#prefsTabs QRadioButton,
#prefsTabs QGroupBox {
    background-color: #181818;
}

QTabWidget::pane {
    border: 1px solid #333333;     /* dark: #333333 */
    border-top-color: #181818;     /* ensure all sides same color */
    border-right-color: #333333;
    border-bottom-color: #333333;
    border-left-color: #333333;
    outline: none;
    /* Prevent native bevels */
    border-image: none;                      /* inner gap to pages */
}

/* === Tree hover & selected === */
QTreeView::item {
    background-color: transparent;
    color: #e6e6e6;
    padding: 4px 6px;
}
QTreeView::item:hover {
    background-color: #061019;  /* uniform hover color */
    color: #ffffff;
}
QTreeView::item:selected {
    background-color: #075cb2;  /* uniform highlight color */
    color: #ffffff;
}

/* ===== Status bar ===== */
QStatusBar {
    background: #1b1b1b;
    color: #cfcfcf;
}

/* ===== Splitter ===== */
QSplitter::handle {
    background-color: #232323;
    margin: 0 2px;
}

/* ===== Scrollbars ===== */
QScrollBar:vertical {
    background: #171717;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #343434;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar:horizontal {
    background: #171717;
    height: 12px;
}
QScrollBar::handle:horizontal {
    background: #343434;
    min-width: 20px;
    border-radius: 6px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0; width: 0;
}

/* ===== Hints ===== */
QLabel#hint {
    color: #9b9b9b;
    font-size: 12px;
    margin-top: 6px;
}

/* ===== Global focus removal ===== */
QTreeView, QTableView, QLineEdit, QTextEdit, QPlainTextEdit,
QComboBox, QSpinBox, QAbstractSpinBox, QPushButton, QScrollBar,
QMenu, QMenuBar, QHeaderView, QSplitter {
    outline: none;
}

TotpRingWidget {
    qproperty-ringColor: #075cb2;   /* progress ring */
    qproperty-trackColor: #343434;  /* track */
    qproperty-bgColor: transparent;     /* inner disk */
    qproperty-thickness: 4;         /* optional */
}