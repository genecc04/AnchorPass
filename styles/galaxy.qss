/* ===== Global ===== */
QWidget {
    background-color: #0b0614;  /* deep galaxy black */
    color: #ece6ff;
    font-family: "Segoe UI", "Inter", "Roboto", Arial, sans-serif;
    font-size: 13px;
    outline: none;
}
* { outline: none; }

QLineEdit { color: #ffffff; }
#totpcopy { color: #ffffff; }

#TopBar {
    background-color: #221632;
}

#topelements{
    background-color: #0b0614;
    border-radius: 0px;
}

QPushButton#topelements{
    color: #ffffff;
    background: #191024;
    min-height: 15px;
    max-height: 15px;
}

QPushButton#topelements:hover   { background: #251338; color: #fff; border-color: #b26bff; }
QPushButton#topelements:focus { border-color: #b26bff; }
QPushButton#topelements:pressed { background: #b26bff; color: #fff; border-color:#b26bff; }
QPushButton#topelements:disabled{ background: #161020; color: #000; border-color:#2a213d; }

QToolTip {
    background-color: #221632;
    color: #f6f2ff;
    border: 1px solid #3a2a54;
    padding: 6px;
    border-radius: 6px;
}

QLabel#DragPreviewChip {
    background-color: #191024;
    color: #ece6ff;
    border-radius: 6px;
    padding: 4px 10px;
    border: 1px solid #3a2a54;
}

/* ===== Settings Tabs (Galaxy Theme) ===== */

/* Main tab widget */
#SettingsTabs {
    background: transparent;
}

/* Frame / page area */
#SettingsTabs::pane {
    border: 1px solid #3a2a54;
    background: #140b24;
    border-radius: 0px;
    padding: 4px;
}

/* Tab bar */
#SettingsTabs QTabBar {
    background: transparent;
}

/* Default (unselected) tab */
#SettingsTabs QTabBar::tab {
    background: #191024;
    color: #e1d7ff;
    border: 1px solid #3a2a54;
    padding: 6px 14px;
    margin-right: 2px;
    margin-top: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

/* Selected tab */
#SettingsTabs QTabBar::tab:selected {
    background: #0b0614;
    color: #ffffff;
    border-color: #3a2a54;
    border-bottom-color: #0b0614;
}

/* Hover (unselected) */
#SettingsTabs QTabBar::tab:hover:!selected {
    background-color: #251338;
    color: #ffffff;
}

/* Disabled tab */
#SettingsTabs QTabBar::tab:disabled {
    background-color: #161020;
    color: #7b7191;
    border-color: #2a213d;
}

/* Optional: inner page content background inside settings tabs */
#SettingsTabs QWidget {
    background-color: #0b0614;
}

#SettingsTabs PlusMinusSpinBox, #SettingsTabs QPushButton, #SettingsTabs QComboBox, #SettingsTabs QLineEdit, #SettingsTabs QTimeEdit{
    background-color: #140b24;
}

/* The container for all hotkey controls */
QWidget#HotkeysPanel {
    background: transparent;
    border: none;
}

/* Labels inside the hotkey panel */
QWidget#HotkeysPanel QLabel {
    color: #ece6ff;
    padding-right: 6px;
}

/* QKeySequenceEdit fields inside the hotkey panel */
QWidget#HotkeysPanel QKeySequenceEdit {
    min-width: 130px;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid #3a2a54;
    background-color: #151024;
}

/* Focus / hover states to make them feel like inputs, not buttons */
QWidget#HotkeysPanel QKeySequenceEdit:focus {
    border: 1px solid #b26bff;
}

/* Optional: when disabled (if you ever disable them via the checkbox) */
QWidget#HotkeysPanel QKeySequenceEdit:disabled {
    background-color: #151024;
    border-color: #2e2343;
    color: #7b7191;
}

/* ===== ModernTable (Galaxy Theme Integration) ===== */
#ModernTable {
    background-color: #0b0614;
    alternate-background-color: #140b24;
    color: #ece6ff;
    border: 1px solid #3a2a54;
    border-radius: 0px;
    gridline-color: #332447;
    selection-background-color: #b26bff;
    selection-color: #ffffff;
    font-family: "Segoe UI", "Inter", "Roboto", Arial, sans-serif;
    font-size: 13px;
}

/* Header styling to match global QHeaderView colors */
#ModernTable QHeaderView::section {
    background-color: #191024;
    color: #e1d7ff;
    border: none;
    border-bottom: 1px solid #332447;
    padding: 6px 8px;
    font-weight: 600;
    font-size: 13px;
}
#ModernTable QHeaderView {
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}
#ModernTable QHeaderView::section:hover {
    background-color: #251338;
}

/* Hover and selected rows */
#ModernTable QTableView::item:hover,
#ModernTable::item:hover {
    background-color: #251338;
    color: #ffffff;
}
#ModernTable QTableView::item:selected,
#ModernTable::item:selected {
    background-color: #b26bff;
    color: #ffffff;
}

/* Scrollbars matching galaxy design */
#ModernTable QScrollBar:vertical {
    background: #130b22;
    width: 12px;
}
#ModernTable QScrollBar::handle:vertical {
    background: #302341;
    min-height: 20px;
    border-radius: 6px;
}
#ModernTable QScrollBar::handle:vertical:hover {
    background: #3e2d56;
}
#ModernTable QScrollBar:horizontal {
    background: #130b22;
    height: 12px;
}
#ModernTable QScrollBar::handle:horizontal {
    background: #302341;
    min-width: 20px;
    border-radius: 6px;
}
#ModernTable QScrollBar::handle:horizontal:hover {
    background: #3e2d56;
}

/* Corner section to blend with header */
#ModernTable QTableCornerButton::section {
    background-color: #191024;
    border: none;
}

/* ===== Inputs (Galaxy-style) ===== */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
PlusMinusSpinBox,
QTimeEdit,
PlusMinusTimeEdit,
#prefsTabs QPushButton {
    background-color: #151024;           /* field bg */
    border: 1px solid #3a2a54;           /* normal border */
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #b26bff; /* purple selection */
    selection-color: #ffffff;
    color: #ece6ff;
}

/* Hover: subtle highlight */
QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QComboBox:hover,
QSpinBox:hover,
PlusMinusSpinBox:hover,
QTimeEdit:hover,
PlusMinusTimeEdit:hover,
#prefsTabs QPushButton:hover {
    border-color: #b26bff;
}

/* Focus: keep strong accent border */
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
PlusMinusSpinBox:focus,
QTimeEdit:focus,
PlusMinusTimeEdit:focus,
#prefsTabs QPushButton:focus {
    border-color: #b26bff;
}

/* ===== Collapsable Section (Galaxy Theme) ===== */

QToolButton#SectionHeaderButton {
    font-weight: 600;
    padding: 6px 8px;
    text-align: left;

    background-color: #191024;      /* same family as tabs/buttons */
    color: #e1d7ff;
    border: 1px solid #3a2a54;
    border-radius: 6px;
}

/* Hover (unselected / collapsed) */
QToolButton#SectionHeaderButton:hover:!checked {
    background-color: #251338;      /* same hover as other controls */
    color: #ffffff;
    border-color: #3a2a54;
}

/* Section has focus (any child widget inside) and is unexpanded */
QToolButton#SectionHeaderButton[sectionFocused="true"]:!checked {
    background-color: #b26bff;      /* strong galaxy purple */
    color: #ffffff;
    border-color: #b26bff;
}

/* Expanded / checked state */
QToolButton#SectionHeaderButton:checked {
    background-color: #140b24;      /* pane / card background tone */
    color: #ffffff;
    border-color: #3a2a54;
}

/* Expanded + hover */
QToolButton#SectionHeaderButton:checked:hover {
    background-color: #251338;      /* same hover purple as tabs */
    color: #ffffff;
    border-color: #4a3470;
}

/* Expanded + section-focused */
QToolButton#SectionHeaderButton[sectionFocused="true"]:checked {
    background-color: #b26bff;      /* focused section highlight */
    color: #ffffff;
    border-color: #b26bff;
}

/* ===== QSpinBox / Auto-lock field ===== */
QAbstractSpinBox {
    background-color: #151024;
    border: 1px solid #3a2a54;
    border-radius: 6px;
    padding-right: 28px;
    color: #ece6ff;
}
QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background: #151024;
    border: none;
    width: 24px;
    border-radius: 6px;
}
QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: rgba(178, 107, 255, 0.18);
}

/* ===== Buttons ===== */
QPushButton {
    background-color: #191024;
    border: 1px solid #3a2a54;
    padding: 8px 14px;
    border-radius: 6px;
    color: #ece6ff;
}
QPushButton:hover {
    background-color: #251338;
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #b26bff;
    color: #ffffff;
}
QPushButton:disabled {
    background-color: #151024;
    color: #7b7191;
    border-color: #2a213d;
}

QDialogButtonBox QPushButton {
    padding: 6px 12px;
    min-width: 88px;
}

/* ===== Checkboxes ===== */
QCheckBox {
    spacing: 6px;
    color: #ece6ff;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #3a2a54;
    background-color: #151024;
}
QCheckBox::indicator:hover {
    border-color: #b26bff;
    background-color: rgba(178, 107, 255, 0.18);
}
QCheckBox::indicator:checked {
    background-color: #b26bff;
    border: 1px solid #b26bff;
    image: url(:/qt-project.org/styles/commonstyle/images/checkboxindicatorcheck.png);
}
QCheckBox::indicator:disabled {
    background-color: #1a1428;
    border-color: #2e2343;
}

/* ===== Menus ===== */
QMenuBar {
    background-color: #120b22;
    color: #ffffff;
    padding: 4px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background-color: #251338;
    color: #ffffff;
}
QMenu {
    background-color: #120b22;
    color: #ffffff;
    border: 1px solid #3a2a54;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px 6px 12px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: #251338;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #877b9f;
}

/* ===== Tables & Trees ===== */
QTreeWidget, QTableWidget, QTableView {
    background-color: #0b0614;
    alternate-background-color: #140b24;
    gridline-color: #332447;
    outline: none;
    border: none;
}

QWidget#prefsTabs{
    background: #140b24;
}

/* Make all text-ish widgets inside the prefs card inherit the card bg */
#prefsTabs QLabel,
#prefsTabs QCheckBox,
#prefsTabs QRadioButton,
#prefsTabs QGroupBox {
    background-color: #140b24;
}

/* ===== Tabs ===== */
QTabWidget::pane {
    border: 1px solid #3a2a54;
    border-top-color: #140b24;
    border-right-color: #3a2a54;
    border-bottom-color: #3a2a54;
    border-left-color: #3a2a54;
    outline: none;
    border-image: none;
}

/* === Tree hover & selected === */
QTreeView::item {
    background-color: transparent;
    color: #ece6ff;
    padding: 4px 6px;
}
QTreeView::item:hover {
    background-color: #251338;
    color: #ffffff;
}
QTreeView::item:selected {
    background-color: #b26bff;
    color: #ffffff;
}

/* === Table hover & selected === */
QTableView::item {
    border-radius: 0px;
    padding: 4px 6px;
}
QTableView::item:hover {
    background-color: #251338;
    color: #ffffff;
}
QTableView::item:selected {
    background-color: #b26bff;
    color: #ffffff;
    border-radius: 0px;
}

/* ===== Headers ===== */
QHeaderView::section {
    background-color: #191024;
    color: #e1d7ff;
    border: 0;
    padding: 6px 8px;
    font-weight: normal;
}
QTableView:focus QHeaderView::section {
    font-weight: normal;
}

/* ===== Status bar ===== */
QStatusBar {
    background: #120b22;
    color: #d7cfff;
}

/* ===== Splitter ===== */
QSplitter::handle {
    background-color: #221632;
    margin: 0 2px;
}

/* ===== Scrollbars ===== */
QScrollBar:vertical {
    background: #130b22;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #302341;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #3e2d56;
}
QScrollBar:horizontal {
    background: #130b22;
    height: 12px;
}
QScrollBar::handle:horizontal {
    background: #302341;
    min-width: 20px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover {
    background: #3e2d56;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    height: 0; width: 0;
}

/* ===== Hints ===== */
QLabel#hint {
    color: #a79ac8;
    font-size: 12px;
    margin-top: 6px;
}

/* ===== Global focus removal ===== */
QTreeView, QTableView, QLineEdit, QTextEdit, QPlainTextEdit,
QComboBox, QSpinBox, QAbstractSpinBox, QPushButton, QScrollBar,
QMenu, QMenuBar, QHeaderView, QSplitter {
    outline: none;
}

/* Optional per-widget tweak */
QAbstractSpinBox#autoLockSpin {
    padding-right: 28px;
}
QAbstractSpinBox#autoLockSpin::up-button,
QAbstractSpinBox#autoLockSpin::down-button {
    width: 24px;
}

/* ===== TOTP Ring Widget ===== */
TotpRingWidget {
    qproperty-ringColor: #b26bff;    /* progress ring (purple) */
    qproperty-trackColor: #302341;   /* track */
    qproperty-bgColor: transparent;  /* inner disk */
    qproperty-thickness: 4;
}
